# Copy this file to ".env" and fill in your own values.
# The application works fully without AI_API_KEY - it falls back to
# built-in rule-based analysis for all AI insights.

# Flask secret key used to sign session cookies. Change this in production.
SECRET_KEY=change-this-to-a-random-secret-string

# Set to False in production
FLASK_DEBUG=True

# Optional: external AI API key (e.g. an LLM provider) for enhanced,
# natural-language insight generation. Leave blank to use the built-in
# rule-based AI insights engine only.
AI_API_KEY=your_api_key_here
